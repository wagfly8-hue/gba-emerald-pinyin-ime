; Memory layout inside sNamingScreen ([0x0203AF04], expanded 0x1F30 -> 0x1F80):
;   +0x1F30..0x1F37: pyBuf[8]    (ASCII 'a'..'z', 0-terminated, max 6)
;   +0x1F38:        pyLen       (u8, 0..6)
;   +0x1F39:        candPage    (u8, 0..N-1, 6 cands per page)
;   +0x1F3A:        activeWinId (u8, cached Win[0] or Win[1] for live redraw)
;   +0x1F3B:        nameMaxChars(u8, cached for underline bounds)
;   +0x1F3C..0x1F47: candChars[12] (6 x {hi, lo} 2-byte Chinese ROM codes, 0 = empty)
;   +0x1F48..0x1F57: nameByteX[16] (per-byte X offset in Name window, 0xFF = 2nd byte)
;   +0x1F58:        nameEndByte (u8)
;   +0x1F59:        nameEndX    (u8)
;   +0x1F5A..0x1F5B: candTotal  (u16 total matching chars for L/R paging)
; ============================================================================

; 1) Expand sNamingScreen EWRAM alloc size from 0x1F30 -> 0x1F80
.org {ADDR_ALLOC_SIZE_LITERAL}
