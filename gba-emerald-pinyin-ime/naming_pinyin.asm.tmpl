; 2) Keyboard tables for 4-page cycle (matches Win[0]/Win[1] + 0x08921A38 backbuffer):
;    curPage=2 (vis=0 a..z) -> 0 (vis=2 0..9) -> 3 (vis=1 A..Z) -> 1 (vis=3 PINYIN) -> 2
.org {TBL_KEYBOARD_CHARS_3}
    ; sKeyboardChars[3]: non-0xFF marks valid keys on cols 0..8, 0xFF on col 9
    .db 0xD5,0xD6,0xD7,0xD8,0xD9,0xDA,0xDB,0xDC,0xDD,0xFF
    .db 0xD5,0xD6,0xD7,0xD8,0xD9,0xDA,0xDB,0xDC,0xDD,0xFF
    .db 0xDE,0xDF,0xE0,0xE1,0xE2,0xE3,0xE4,0xE5,0xE6,0xFF
    .db 0xE7,0xE8,0xE9,0xEA,0xEB,0xEC,0xED,0xEE,0xAE,0xFF

.org {TBL_COL_COUNTS}
    .db 8, 8, 6, 9, 10   ; colCounts[0..4] -> subpage 3 has 9 cols (0..8)

.org {TBL_COL_X_BASE} + 30
    .db 0, 16, 32, 48, 64, 80, 96, 112, 128, 0 ; subpage 3 X coordinates (16px grid)

.org {TBL_BUTTON_IDX}
    .db 0, 2, 1, 3, 0    ; buttonIdx[curPage]: 0->0(UPPER), 1->2(lower), 2->1(others), 3->3(拼音)
    .db 1, 0, 2, 3, 4    ; BackSubpage[curPage] (0x0891F67C): 0->1(A..Z), 1->0(a..z), 2->2(0..9), 3->3(PINYIN)
    .db 2, 3, 0, 1, 4    ; VisSubpage[curPage]  (0x0891F69C): 0->2(0..9), 1->3(PINYIN), 2->0(a..z), 3->1(A..Z)
    .db 2, 3, 0, 1, 4    ; NextCurOnSwap[nxt]:  0->2, 1->3, 2->0, 3->1

; Use BLUE border tilemap (0x098D9264) for curPage=3 (pre-draws PINYIN backbuffer)
.org {ADDR_BORDER_TILEMAP_3_PTR}
    .dw {GFX_BLUE_BORDER_TM}

; 2b) Zero-initialize IME extra state (+0x1F30..+0x1F5F) on NamingScreen init
